{
  "expo": {
    "name": "Jewels & Fits",
    "slug": "jewelsandfits-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "jewelsandfits",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.sarizona.jewelsandfits",
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.sarizona.jewelsandfits",
      "adaptiveIcon": {
        "backgroundColor": "#F7EEF3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B1F52",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "color": "#5B1F52",
          "defaultChannel": "orders"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "250022f6-025e-4e37-ba3a-34a8d6deef6a"
      }
    },
    "owner": "venson01s-team"
  }
}
