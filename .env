# Public build settings, committed so EAS builds get them too. Client IDs are not secrets.
# Machine-specific overrides (e.g. EXPO_PUBLIC_API_URL) go in .env.local, which is not committed.

# Google OAuth "Web application" client: the same one the website uses (AUTH_GOOGLE_ID).
# Google issues the app's ID token for this client, so the server can verify it.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=857515493209-e6pnqn996nt6u7bt3aljenrud71fs97k.apps.googleusercontent.com

# Google OAuth "iOS" client ID, once created (bundle ID com.sarizona.jewelsandfits).
# Also add it to AUTH_GOOGLE_MOBILE_CLIENT_IDS on the website.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
